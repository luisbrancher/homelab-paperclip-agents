# Managed by Ansible. Egress proxy for the paperclip user: only the domains in /etc/tinyproxy/filter are allowed.
User tinyproxy
Group tinyproxy
Port {{ paperclip_proxy_port }}
Listen 127.0.0.1
Allow 127.0.0.1
Timeout 1800
MaxClients 100
Syslog On
LogLevel Notice
DisableViaHeader Yes
DefaultErrorFile "/usr/share/tinyproxy/default.html"
StatFile "/usr/share/tinyproxy/stats.html"
ConnectPort 443

Filter "/etc/tinyproxy/filter"
FilterType ere
FilterURLs Off
FilterCaseSensitive Off
FilterDefaultDeny Yes
