{
  "name": "SRE",
  "role": "devops",
  "title": "SRE / Incident triager",
  "icon": "eye",
  "capabilities": "Diagnoses incidents using Prometheus, Loki and the k3s state (read-only)",
  "reports_to_coordinator": true,
  "adapter": {
    "model": "claude-haiku-4-5",
    "maxTurnsPerRun": 40,
    "timeoutSec": 900,
    "dangerouslySkipPermissions": false,
    "extraArgs": [
      "--allowedTools",
      "Read,Grep,Glob,Bash(curl:*),Bash(git log:*),Bash(git diff:*),Bash(git status:*)"
    ]
  },
  "heartbeat_enabled": false
}
