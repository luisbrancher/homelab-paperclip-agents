{
  "name": "Storage & Backup",
  "role": "devops",
  "title": "Storage & Backup",
  "icon": "wrench",
  "capabilities": "Checks backups, restore readiness and capacity",
  "reports_to_coordinator": true,
  "adapter": {
    "model": "claude-haiku-4-5",
    "maxTurnsPerRun": 40,
    "timeoutSec": 900,
    "dangerouslySkipPermissions": false,
    "extraArgs": [
      "--allowedTools",
      "Read,Grep,Glob,Bash(curl:*),Bash(git log:*),Bash(git diff:*),Bash(git status:*)"
    ]
  },
  "heartbeat_enabled": false
}
